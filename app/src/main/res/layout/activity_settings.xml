<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F7FA"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="#F5F7FA"
            app:title="Configuración"
            app:titleTextColor="#183153"
            app:navigationIcon="@drawable/ic_arrow_back_24" />

        <!-- NAVEGACIÓN -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Navegación"
            android:textColor="#183153"
            android:textSize="18sp"
            android:textStyle="bold"
            android:paddingTop="20dp"
            android:paddingBottom="8dp" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="12dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="#FFFFFF">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Aplicación de navegación predeterminada"
                    android:textColor="#183153"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <RadioGroup
                    android:id="@+id/rgNavigationApp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingTop="8dp">

                    <RadioButton
                        android:id="@+id/rbGoogleMaps"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Google Maps"
                        android:checked="true" />

                    <RadioButton
                        android:id="@+id/rbWaze"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Waze" />

                </RadioGroup>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- OPTIMIZACIÓN -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Optimización de rutas"
            android:textColor="#183153"
            android:textSize="18sp"
            android:textStyle="bold"
            android:paddingTop="24dp"
            android:paddingBottom="8dp" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="12dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="#FFFFFF">

            <RadioGroup
                android:id="@+id/rgOptimization"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <RadioButton
                    android:id="@+id/rbNearest"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Greedy (destino más cercano)"
                    android:checked="true" />

                <RadioButton
                    android:id="@+id/rbGlobal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Google Routes API" />

            </RadioGroup>

        </com.google.android.material.card.MaterialCardView>

        <!-- UBICACIÓN -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Ubicación"
            android:textColor="#183153"
            android:textSize="18sp"
            android:textStyle="bold"
            android:paddingTop="24dp"
            android:paddingBottom="8dp" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="12dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="#FFFFFF">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="16dp"
                android:text="Route Planner utiliza los permisos de ubicación de Android para obtener tu posición cuando creas una ruta."
                android:textColor="#64748B"
                android:textSize="14sp" />

        </com.google.android.material.card.MaterialCardView>

        <!-- INFORMACIÓN -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Información de la aplicación"
            android:textColor="#183153"
            android:textSize="18sp"
            android:textStyle="bold"
            android:paddingTop="24dp"
            android:paddingBottom="8dp" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="12dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="#FFFFFF">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Route Planner"
                    android:textColor="#183153"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvAppVersion"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Versión 1.0"
                    android:textColor="#64748B"
                    android:textSize="14sp"
                    android:paddingTop="4dp" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>

</ScrollView>