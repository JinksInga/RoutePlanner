<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="2dp"
    app:cardBackgroundColor="#FFFFFF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/tvRouteName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Nombre de la ruta"
            android:textColor="#183153"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvRouteStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Ruta pausada"
            android:textColor="#B7791F"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvRouteProgress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="5 paradas · 2 completadas"
            android:textColor="#64748B"
            android:textSize="14sp" />

        <Button
            android:id="@+id/btnEditRoute"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Modificar ruta"
            android:layout_marginTop="8dp" />

        <Button
            android:id="@+id/btnDeleteRoute"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Eliminar ruta"
            android:textColor="#FFFFFF"
            android:backgroundTint="#C62828" />

        <Button
            android:id="@+id/btnSelectRoute"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="12dp"
            android:text="Continuar ruta" />

    </LinearLayout>

</androidx.cardview.widget.CardView>