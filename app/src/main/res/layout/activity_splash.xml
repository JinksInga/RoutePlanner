<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:orientation="vertical">
    
    <!-- Mapa animado -->
    <com.routeplanner.app.activities.RouteMapAnimationView
        android:id="@+id/routeMap"
        android:layout_width="200dp"
        android:layout_height="200dp"
        android:contentDescription="@string/content_description_map_with_navigation_route" />

    <!-- Nombre de la aplicación -->
    <TextView
        android:id="@+id/txtTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:alpha="0"
        android:fontFamily="sans-serif"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:text="@string/app_name"
        android:textColor="@color/rp_primary_dark"
        android:textSize="34sp"
        android:textStyle="bold" />

    <!-- Eslogan animado -->

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/txtPlan"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:alpha="0"
            android:text="@string/text_plan"
            android:textColor="@color/rp_primary_dark"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/dot1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:alpha="0"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:text="@string/text_dot"
            android:textColor="@color/rp_primary"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtCalculate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:alpha="0"
            android:text="@string/text_calculate"
            android:textColor="@color/rp_primary_dark"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/dot2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:alpha="0"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:text="@string/text_dot"
            android:textColor="@color/rp_primary"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtOptimizes"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:alpha="0"
            android:text="@string/text_optimizes"
            android:textColor="@color/rp_primary_dark"
            android:textSize="16sp" />
    </LinearLayout>

</LinearLayout>