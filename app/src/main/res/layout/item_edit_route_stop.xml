<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="2dp"
    app:cardBackgroundColor="#FFFFFF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <TextView
            android:id="@+id/tvEditStopNumber"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Parada 1"
            android:textColor="#183153"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvEditStopAddress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Dirección de la parada"
            android:textColor="#475569"
            android:textSize="14sp"
            android:layout_marginTop="4dp" />

        <TextView
            android:id="@+id/tvEditStopStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Pendiente"
            android:textColor="#64748B"
            android:textSize="12sp"
            android:layout_marginTop="4dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="end"
            android:layout_marginTop="8dp">

            <Button
                android:id="@+id/btnMoveStopUp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="48dp"
                android:text="↑"
                android:contentDescription="Subir parada" />

            <Button
                android:id="@+id/btnMoveStopDown"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="48dp"
                android:text="↓"
                android:contentDescription="Bajar parada" />

            <Button
                android:id="@+id/btnRemoveStop"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Quitar" />

        </LinearLayout>

    </LinearLayout>

</androidx.cardview.widget.CardView>