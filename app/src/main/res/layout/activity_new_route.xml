<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#F5F7FA"
    android:nestedScrollingEnabled="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Nueva ruta"
            android:textSize="26sp"
            android:textStyle="bold"
            android:textColor="#183153"
            android:layout_marginBottom="20dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="PUNTO DE PARTIDA"
            android:textStyle="bold"
            android:textColor="#183153"
            android:layout_marginBottom="8dp"/>


        <Button
            android:id="@+id/btnCurrentLocation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Usar mi ubicación actual"
            android:drawableStart="@android:drawable/ic_menu_mylocation"
            android:layout_marginBottom="10dp" />

        <Button
            android:id="@+id/btnManualOrigin"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Introducir dirección manualmente"
            android:drawableStart="@android:drawable/ic_menu_search" />

        <TextView
            android:id="@+id/tvSelectedOrigin"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Todavía no has seleccionado un punto de partida"
            android:textColor="#607080"
            android:padding="12dp"
            android:layout_marginTop="8dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="DESTINOS"
            android:textStyle="bold"
            android:textColor="#183153"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:id="@+id/tvDestinationCount"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Selecciona las direcciones que deseas visitar"
            android:textColor="#607080"
            android:layout_marginBottom="8dp"/>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvRouteDestinations"
            android:layout_width="match_parent"
            android:layout_height="250dp"
            android:nestedScrollingEnabled="true"
            android:overScrollMode="always"/>

        <TextView
            android:id="@+id/tvNoDestinations"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Todavía no tienes direcciones guardadas."
            android:textColor="#607080"
            android:padding="16dp"
            android:textAlignment="center"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="MÉTODO DE ORDENACIÓN"
            android:textStyle="bold"
            android:textColor="#183153"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="8dp"/>

        <RadioGroup
            android:id="@+id/rgOptimization"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <RadioButton
                android:id="@+id/rbNearest"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Vecino más cercano"
                android:checked="true"/>

            <RadioButton
                android:id="@+id/rbGlobal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Optimización global (Google Routes)"/>

        </RadioGroup>

        <Button
            android:id="@+id/btnCalculateRoute"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="Calcular ruta"
            android:layout_marginTop="24dp"/>

    </LinearLayout>
</ScrollView>