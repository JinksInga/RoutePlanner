<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/rp_background">

    <!-- BARRA SUPERIOR -->
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/rp_surface"
        app:title="@string/title_new_route"
        app:titleTextColor="@color/rp_text_primary"
        app:navigationIcon="@drawable/ic_arrow_back_24"
        app:navigationIconTint="@color/rp_text_primary"
        app:elevation="2dp" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- INTRODUCCIÓN -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/title_let_us_plan_your_route"
                android:textColor="@color/rp_text_primary"
                android:textSize="23sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="24dp"
                android:text="@string/comment_let_us_plan_your_route"
                android:textColor="@color/rp_text_secondary"
                android:textSize="14sp" />

            <!-- NOMBRE DE LA RUTA -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilRouteName"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/text_input_route_name"
                app:boxStrokeColor="@color/rp_primary"
                app:hintTextColor="@color/rp_primary">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etRouteName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textCapSentences"
                    android:maxLines="1"
                    android:imeOptions="actionNext" />

            </com.google.android.material.textfield.TextInputLayout>

            <!-- PUNTO DE PARTIDA -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:layout_marginBottom="10dp"
                android:text="@string/title_starting_point"
                android:textColor="@color/rp_text_primary"
                android:textSize="13sp"
                android:textStyle="bold" />

            <!-- BANNER DE ESTADO / INLINE ALERT (Oculto por defecto) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/bannerStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:visibility="gone"
                app:cardCornerRadius="10dp" >

                <TextView
                    android:id="@+id/tvBannerMessage"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:contentDescription="@string/content_description_gps_status"
                    android:drawablePadding="8dp"
                    android:gravity="center_vertical"
                    android:padding="4dp"
                    android:textColor="@color/md_theme_background"
                    android:textSize="13sp" />

            </com.google.android.material.card.MaterialCardView>

            <!-- DIRECCIÓN SELECCIONADA -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/rp_surface"
                app:cardCornerRadius="12dp"
                app:strokeColor="@color/rp_outline"
                app:strokeWidth="1dp">

                <TextView
                    android:id="@+id/tvSelectedOrigin"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="16dp"
                    android:gravity="center_vertical"
                    android:text="@string/comment_starting_point"
                    android:textColor="@color/rp_text_secondary"
                    android:textSize="14sp"
                    android:drawablePadding="16dp"
                    app:drawableStartCompat="@drawable/ic_home_work_24" />

            </com.google.android.material.card.MaterialCardView>

            <!-- OPCIONES DE ORIGEN -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="horizontal"
                android:weightSum="2">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnCurrentLocation"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:minHeight="52dp"
                    android:text="@string/btn_current_location"
                    android:textColor="@color/rp_text_primary"
                    app:backgroundTint="@color/rp_icon_background"
                    app:cornerRadius="10dp"
                    app:icon="@drawable/ic_my_location_24"
                    app:iconGravity="textStart"
                    app:iconSize="24dp"
                    app:iconTint="@null" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnManualOrigin"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:minHeight="52dp"
                    android:text="@string/btn_manual_steering"
                    android:textColor="@color/rp_text_primary"
                    app:backgroundTint="@color/rp_icon_background"
                    app:cornerRadius="10dp"
                    app:icon="@drawable/ic_search_address_24"
                    app:iconGravity="textStart"
                    app:iconSize="24dp"
                    app:iconTint="@null" />

            </LinearLayout>

            <!-- METHOD DE OPTIMIZACIÓN -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="30dp"
                android:layout_marginBottom="10dp"
                android:text="@string/title_optimization_method"
                android:textColor="@color/rp_text_primary"
                android:textSize="13sp"
                android:textStyle="bold" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilOptimization"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:boxStrokeColor="@color/rp_primary">

                <com.google.android.material.textfield.MaterialAutoCompleteTextView
                    android:id="@+id/actOptimization"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:importantForAutofill="no"
                    android:inputType="none"
                    android:textColor="@color/rp_text_primary"
                    tools:text="Método de optimización" />

            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/comment_optimization_method"
                android:textColor="@color/rp_text_secondary"
                android:textSize="12sp" />

            <!-- REGRESO AL PUNTO DE PARTIDA -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                app:cardBackgroundColor="@color/rp_surface"
                app:cardCornerRadius="12dp"
                app:strokeColor="@color/rp_outline"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/title_return_to_origin"
                            android:textColor="@color/rp_text_primary"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="5dp"
                            android:text="@string/comment_return_to_origin"
                            android:textColor="@color/rp_text_secondary"
                            android:textSize="12sp" />

                    </LinearLayout>

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/switchReturnToOrigin"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:checked="true"
                        android:contentDescription="@string/content_description_return_to_origin"
                        android:textOff="@string/text_return_origin_switch_off"
                        android:textOn="@string/text_return_origin_switch_on"
                        app:showText="true"
                        app:switchTextAppearance="@style/SwitchTextAppearance"
                        app:thumbTextPadding="3dp" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

    </ScrollView>

    <!-- ACCIÓN INFERIOR -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/rp_surface"
        android:elevation="6dp"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="16dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSelectDestinations"
            android:layout_width="320dp"
            android:layout_height="wrap_content"
            android:text="@string/btn_select_destinations"
            app:cornerRadius="16dp"
            app:icon="@drawable/ic_arrow_forward_24"
            app:iconGravity="end" />

    </LinearLayout>

</LinearLayout>