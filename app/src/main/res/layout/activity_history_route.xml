<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F5F7FA"
    android:padding="16dp">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="#F5F7FA"
        app:title="Detalle de ruta"
        app:titleTextColor="#183153"
        app:navigationIcon="@drawable/ic_arrow_back_24" />

    <TextView
        android:id="@+id/tvHistoryRouteName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Nombre de la ruta"
        android:textColor="#183153"
        android:textSize="22sp"
        android:textStyle="bold"
        android:paddingTop="16dp"
        android:paddingBottom="8dp" />

    <TextView
        android:id="@+id/tvHistoryRouteOrigin"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Origen de la ruta"
        android:textColor="#64748B"
        android:textSize="14sp"
        android:paddingBottom="16dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Destinos de la ruta"
        android:textColor="#183153"
        android:textSize="18sp"
        android:textStyle="bold"
        android:paddingBottom="12dp" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvHistoryRouteStops"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingBottom="12dp" />

</LinearLayout>