<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Estado cuando el usuario MANTIENE PULSADA la tarjeta (pressed = true) -->
    <item android:state_pressed="true">
        <set>
            <!-- Reduce ligeramente la escala a 0.96 -->
            <objectAnimator
                android:propertyName="scaleX"
                android:valueTo="0.96"
                android:duration="100"/>
            <objectAnimator
                android:propertyName="scaleY"
                android:valueTo="0.96"
                android:duration="100"/>
            <!-- Opcional: baja un poco la elevación si quieres -->
            <objectAnimator
                android:propertyName="translationZ"
                android:valueTo="2dp"
                android:duration="100"/>
        </set>
    </item>

    <!-- Estado por defecto (cuando NO está pulsada) -->
    <item>
        <set>
            <objectAnimator
                android:propertyName="scaleX"
                android:valueTo="1.0"
                android:duration="150"/>
            <objectAnimator
                android:propertyName="scaleY"
                android:valueTo="1.0"
                android:duration="150"/>
            <objectAnimator
                android:propertyName="translationZ"
                android:valueTo="0dp"
                android:duration="150"/>
        </set>
    </item>
</selector>